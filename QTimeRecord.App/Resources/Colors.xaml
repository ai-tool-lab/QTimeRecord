  <!--
    打刻種別の色。DESIGN.md の front matter には無く、モック
    （img/メイン画面_打刻.html）から採った。ここだけ出所が違う。

    4種を色で見分けられることは操作の速さに直結する。文字だけにすると
    タッチする前に読ませることになり、キオスク端末では致命的に遅い。
    Pressed は各色を暗くしたもの（タッチには hover が無いため押下で表現する）。
  -->
  <Color x:Key="Color.ClockIn">#059669</Color>
  <Color x:Key="Color.ClockInPressed">#047857</Color>
  <Color x:Key="Color.ClockOut">#3730A3</Color>
  <Color x:Key="Color.ClockOutPressed">#312E81</Color>
  <Color x:Key="Color.BreakStart">#D97706</Color>
  <Color x:Key="Color.BreakStartPressed">#B45309</Color>
  <Color x:Key="Color.BreakEnd">#334155</Color>
  <Color x:Key="Color.BreakEndPressed">#1E293B</Color>

  <SolidColorBrush x:Key="Brush.ClockIn" Color="{StaticResource Color.ClockIn}" />
  <SolidColorBrush x:Key="Brush.ClockInPressed" Color="{StaticResource Color.ClockInPressed}" />
  <SolidColorBrush x:Key="Brush.ClockOut" Color="{StaticResource Color.ClockOut}" />
  <SolidColorBrush x:Key="Brush.ClockOutPressed" Color="{StaticResource Color.ClockOutPressed}" />
  <SolidColorBrush x:Key="Brush.BreakStart" Color="{StaticResource Color.BreakStart}" />
  <SolidColorBrush x:Key="Brush.BreakStartPressed" Color="{StaticResource Color.BreakStartPressed}" />
  <SolidColorBrush x:Key="Brush.BreakEnd" Color="{StaticResource Color.BreakEnd}" />
  <SolidColorBrush x:Key="Brush.BreakEndPressed" Color="{StaticResource Color.BreakEndPressed}" />

</ResourceDictionary>
