  <Color x:Key="Color.PrimaryFixed">#DBE1FF</Color>
  <Color x:Key="Color.PrimaryFixedDim">#B5C5FC</Color>
  <Color x:Key="Color.OnPrimaryFixed">#051846</Color>
  <Color x:Key="Color.OnPrimaryFixedVariant">#354574</Color>
  <Color x:Key="Color.SecondaryFixed">#DCE1FF</Color>
  <Color x:Key="Color.SecondaryFixedDim">#B6C4FF</Color>
  <Color x:Key="Color.OnSecondaryFixed">#001550</Color>
  <Color x:Key="Color.OnSecondaryFixedVariant">#093BAE</Color>
  <Color x:Key="Color.TertiaryFixed">#A6F5AE</Color>
  <Color x:Key="Color.TertiaryFixedDim">#8BD894</Color>
  <Color x:Key="Color.OnTertiaryFixed">#002109</Color>
  <Color x:Key="Color.OnTertiaryFixedVariant">#005320</Color>
  <Color x:Key="Color.Background">#F9F9FF</Color>
  <Color x:Key="Color.OnBackground">#141B2B</Color>
