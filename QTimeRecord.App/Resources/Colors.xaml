  <SolidColorBrush x:Key="Brush.InversePrimary" Color="{StaticResource Color.InversePrimary}" />
  <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}" />
  <SolidColorBrush x:Key="Brush.OnSecondary" Color="{StaticResource Color.OnSecondary}" />
  <SolidColorBrush x:Key="Brush.SecondaryContainer" Color="{StaticResource Color.SecondaryContainer}" />
  <SolidColorBrush x:Key="Brush.OnSecondaryContainer" Color="{StaticResource Color.OnSecondaryContainer}" />
  <SolidColorBrush x:Key="Brush.Tertiary" Color="{StaticResource Color.Tertiary}" />
  <SolidColorBrush x:Key="Brush.OnTertiary" Color="{StaticResource Color.OnTertiary}" />
  <SolidColorBrush x:Key="Brush.TertiaryContainer" Color="{StaticResource Color.TertiaryContainer}" />
  <SolidColorBrush x:Key="Brush.OnTertiaryContainer" Color="{StaticResource Color.OnTertiaryContainer}" />
  <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
  <SolidColorBrush x:Key="Brush.OnError" Color="{StaticResource Color.OnError}" />
  <SolidColorBrush x:Key="Brush.ErrorContainer" Color="{StaticResource Color.ErrorContainer}" />
  <SolidColorBrush x:Key="Brush.OnErrorContainer" Color="{StaticResource Color.OnErrorContainer}" />
  <SolidColorBrush x:Key="Brush.PrimaryFixed" Color="{StaticResource Color.PrimaryFixed}" />
  <SolidColorBrush x:Key="Brush.PrimaryFixedDim" Color="{StaticResource Color.PrimaryFixedDim}" />
  <SolidColorBrush x:Key="Brush.OnPrimaryFixed" Color="{StaticResource Color.OnPrimaryFixed}" />
  <SolidColorBrush x:Key="Brush.OnPrimaryFixedVariant" Color="{StaticResource Color.OnPrimaryFixedVariant}" />
  <SolidColorBrush x:Key="Brush.SecondaryFixed" Color="{StaticResource Color.SecondaryFixed}" />
