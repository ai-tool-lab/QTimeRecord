  <Color x:Key="Color.OnSecondary">#FFFFFF</Color>
  <Color x:Key="Color.SecondaryContainer">#2F60DE</Color>
  <Color x:Key="Color.OnSecondaryContainer">#F8FAFF</Color>
  <Color x:Key="Color.Tertiary">#003E17</Color>
  <Color x:Key="Color.OnTertiary">#FFFFFF</Color>
