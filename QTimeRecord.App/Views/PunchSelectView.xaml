<UserControl x:Class="QTimeRecord.App.Views.PunchSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:domain="clr-namespace:QTimeRecord.Core.Domain;assembly=QTimeRecord.Core"
             xmlns:vm="clr-namespace:QTimeRecord.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PunchSelectViewModel}"
             Background="{StaticResource Brush.Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 認証できたこと と 自動キャンセルまでの残り -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.SurfaceContainerLowest}"
                BorderBrush="{StaticResource Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                Padding="24,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="QRコードを確認しました。打刻の種別をタッチしてください。"
                               Style="{StaticResource Text.HeadlineSm}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="自動キャンセルまで"
                                   Style="{StaticResource Text.LabelLg}"
                                   Foreground="{StaticResource Brush.OnSurfaceVariant}"
                                   VerticalAlignment="Center" />
                        <!-- 秒数は等幅。1桁に減るときに周りが動かないようにする -->
                        <TextBlock Text="{Binding RemainingSeconds}"
                                   Style="{StaticResource Text.HeadlineMd}"
                                   Foreground="{StaticResource Brush.Error}"
                                   MinWidth="48"
                                   TextAlignment="Right"
                                   Margin="8,0,4,0" />
                        <TextBlock Text="秒"
                                   Style="{StaticResource Text.LabelLg}"
                                   Foreground="{StaticResource Brush.OnSurfaceVariant}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 残り時間のバー。数字だけだと、手元を見ている人は減っていることに気づけない -->
                <ProgressBar Height="8"
                             Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="{Binding TimeoutSeconds, Mode=OneTime}"
                             Value="{Binding RemainingSeconds, Mode=OneWay}"
                             Background="{StaticResource Brush.SurfaceContainerLow}"
                             Foreground="{StaticResource Brush.Secondary}"
                             BorderThickness="0">
                    <ProgressBar.Template>
                        <!-- 既定のテンプレートは光沢のアニメーションを含む。静かな表示にする -->
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>
        </Border>

        <!-- 対象スタッフ・前回打刻・キャンセル -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.SurfaceContainerLowest}"
                BorderBrush="{StaticResource Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                Margin="0,16,0,16"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource Brush.PrimaryFixed}"
                                CornerRadius="{StaticResource Radius.Button}"
                                Padding="10,2"
                                Margin="0,0,8,0"
                                Visibility="{Binding StaffNo, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding StaffNo}"
                                       Style="{StaticResource Text.TabularData}"
                                       Foreground="{StaticResource Brush.OnPrimaryFixed}" />
                        </Border>
                        <Border Background="{StaticResource Brush.SurfaceContainerLow}"
                                CornerRadius="{StaticResource Radius.Button}"
                                Padding="10,2"
                                Visibility="{Binding EmploymentType, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding EmploymentType}"
                                       Style="{StaticResource Text.LabelLg}"
                                       Foreground="{StaticResource Brush.OnSurfaceVariant}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.HeadlineMd}" Margin="0,6,0,0">
                        <Run Text="{Binding StaffName, Mode=OneWay}" />
                        <Run Text=" さん" FontSize="16" Foreground="{StaticResource Brush.OnSurfaceVariant}" />
                    </TextBlock>
                </StackPanel>

                <!-- 前回の打刻。誤って同じ種別を続けて押していないか、本人が気づけるようにする -->
                <Border Grid.Column="1"
                        Background="{StaticResource Brush.SurfaceContainerLow}"
                        CornerRadius="{StaticResource Radius.Button}"
                        Padding="16,10"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding LastPunchText, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <TextBlock Text="前回の打刻"
                                   Style="{StaticResource Text.LabelMd}"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding LastPunchText}"
                                   Style="{StaticResource Text.TabularData}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="2"
                        Content="キャンセル"
                        Style="{StaticResource Button.SecondaryTouch}"
                        Command="{Binding CancelCommand}"
                        MinWidth="180" />
            </Grid>
        </Border>

        <!-- 打刻種別。4枚を等分に置き、色で見分けさせる -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- リーダーが切れている間は打刻できない。理由を必ず出す -->
            <Border Grid.Row="0"
                    Background="{StaticResource Brush.ErrorContainer}"
                    CornerRadius="{StaticResource Radius.Button}"
                    Padding="20,12"
                    Margin="0,0,0,12"
                    Visibility="{Binding ScannerWarning, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding ScannerWarning}"
                           Style="{StaticResource Text.HeadlineSm}"
                           Foreground="{StaticResource Brush.OnErrorContainer}"
                           TextWrapping="Wrap" />
            </Border>

            <UniformGrid Grid.Row="1" Rows="2" Columns="2">
                <Button Style="{StaticResource Button.PunchClockIn}"
                        Command="{Binding PunchCommand}"
                        CommandParameter="{x:Static domain:TimeRecordType.ClockIn}">
                    <Grid>
                        <TextBlock Text="CLOCK-IN"
                                   Style="{StaticResource Text.LabelLg}"
                                   Foreground="{StaticResource Brush.OnPrimary}"
                                   Opacity="0.8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top" />
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="出 勤"
                                       Style="{StaticResource Text.HeadlineLg}"
                                       Foreground="{StaticResource Brush.OnPrimary}" />
                            <TextBlock Text="業務を開始します"
                                       Style="{StaticResource Text.BodyLg}"
                                       Foreground="{StaticResource Brush.OnPrimary}"
                                       Opacity="0.9"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource Button.PunchClockOut}"
                        Command="{Binding PunchCommand}"
                        CommandParameter="{x:Static domain:TimeRecordType.ClockOut}">
                    <Grid>
                        <TextBlock Text="CLOCK-OUT"
                                   Style="{StaticResource Text.LabelLg}"
                                   Foreground="{StaticResource Brush.OnPrimary}"
                                   Opacity="0.8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top" />
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="退 勤"
                                       Style="{StaticResource Text.HeadlineLg}"
                                       Foreground="{StaticResource Brush.OnPrimary}" />
                            <TextBlock Text="本日の業務を終了します"
                                       Style="{StaticResource Text.BodyLg}"
                                       Foreground="{StaticResource Brush.OnPrimary}"
                                       Opacity="0.9"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource Button.PunchBreakStart}"
                        Command="{Binding PunchCommand}"
                        CommandParameter="{x:Static domain:TimeRecordType.BreakStart}">
                    <Grid>
                        <TextBlock Text="BREAK START"
                                   Style="{StaticResource Text.LabelLg}"
                                   Foreground="{StaticResource Brush.OnPrimary}"
                                   Opacity="0.8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top" />
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="中抜け開始"
                                       Style="{StaticResource Text.HeadlineLg}"
                                       Foreground="{StaticResource Brush.OnPrimary}" />
                            <TextBlock Text="一時的に業務を離れます"
                                       Style="{StaticResource Text.BodyLg}"
                                       Foreground="{StaticResource Brush.OnPrimary}"
                                       Opacity="0.9"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource Button.PunchBreakEnd}"
                        Command="{Binding PunchCommand}"
                        CommandParameter="{x:Static domain:TimeRecordType.BreakEnd}">
                    <Grid>
                        <TextBlock Text="BREAK END"
                                   Style="{StaticResource Text.LabelLg}"
                                   Foreground="{StaticResource Brush.OnPrimary}"
                                   Opacity="0.8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top" />
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="中抜け終了"
                                       Style="{StaticResource Text.HeadlineLg}"
                                       Foreground="{StaticResource Brush.OnPrimary}" />
                            <TextBlock Text="業務に復帰します"
                                       Style="{StaticResource Text.BodyLg}"
                                       Foreground="{StaticResource Brush.OnPrimary}"
                                       Opacity="0.9"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
