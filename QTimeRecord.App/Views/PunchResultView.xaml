<UserControl x:Class="QTimeRecord.App.Views.PunchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QTimeRecord.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PunchResultViewModel}"
             Background="{StaticResource Brush.Surface}">

    <!--
        打刻できたことが一目で分かる画面にする。
        分からないと、スタッフはもう一度かざし、二重打刻になる。
        色（緑）・大きなチェック・打刻種別の3つを重ねて伝える。
    -->
    <Border Background="{StaticResource Brush.SurfaceContainerLowest}"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}"
            Margin="24"
            Padding="48,40">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- チェック印。画像を持たず、線2本で描く -->
            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                <Ellipse Fill="{StaticResource Brush.ClockIn}" />
                <Path Stroke="{StaticResource Brush.OnPrimary}"
                      StrokeThickness="8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Data="M 26,50 L 42,66 L 70,32"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top" />
            </Grid>

            <TextBlock Text="{Binding RecordedAt, StringFormat={}{0:yyyy年M月d日 (dddd) HH:mm:ss}}"
                       Style="{StaticResource Text.TabularData}"
                       Foreground="{StaticResource Brush.TextMuted}"
                       HorizontalAlignment="Center"
                       Margin="0,24,0,0" />

            <TextBlock Text="{Binding Headline}"
                       Style="{StaticResource Text.HeadlineLg}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />

            <TextBlock Style="{StaticResource Text.BodyLg}"
                       Foreground="{StaticResource Brush.OnSurfaceVariant}"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0">
                <Run Text="{Binding StaffName, Mode=OneWay}" />
                <Run Text="さん、お疲れさまです。" />
            </TextBlock>

            <Border Background="{StaticResource Brush.SurfaceContainerLow}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Button}"
                    Padding="32,16"
                    Margin="0,28,0,0"
                    HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="打刻区分"
                               Style="{StaticResource Text.LabelMd}"
                               Foreground="{StaticResource Brush.TextMuted}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding RecordTypeLabel}"
                               Style="{StaticResource Text.HeadlineSm}"
                               Foreground="{StaticResource Brush.Secondary}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!--
                営業時間外は、あとで管理者に確認されることをその場で伝える。
                赤にしない。大きな緑のチェックの隣に赤を置くと、
                打刻が失敗したように見える。打刻自体は成功している。
            -->
            <Border Background="{StaticResource Brush.SurfaceContainerHigh}"
                    BorderBrush="{StaticResource Brush.Outline}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Button}"
                    Padding="20,12"
                    MaxWidth="560"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsOutsideBusinessHours, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="{Binding OutsideBusinessHoursNote}"
                           Style="{StaticResource Text.BodyLg}"
                           Foreground="{StaticResource Brush.OnSurfaceVariant}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>

            <TextBlock Text="まもなく待機画面へ戻ります"
                       Style="{StaticResource Text.LabelLg}"
                       Foreground="{StaticResource Brush.TextMuted}"
                       HorizontalAlignment="Center"
                       Margin="0,28,0,0" />
        </StackPanel>
    </Border>
</UserControl>
