<Window x:Class="QTimeRecord.App.Views.Dialogs.TouchDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle, RelativeSource={RelativeSource Self}}"
        SizeToContent="Height"
        Width="560"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource Font.Ui}">

    <!--
        MessageBox を使わない理由: 既定のボタンがタッチには小さすぎる（20px 前後）。
        誤タップは打刻の取り消しや削除の誤操作に直結するため、64px を確保する。
    -->
    <Border Background="{StaticResource Brush.SurfaceContainerLowest}"
            BorderBrush="{StaticResource Brush.OutlineVariant}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#111827" />
        </Border.Effect>

        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="TitleText"
                       Style="{StaticResource Text.HeadlineSm}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="1"
                       x:Name="MessageText"
                       Style="{StaticResource Text.BodyLg}"
                       Foreground="{StaticResource Brush.OnSurfaceVariant}"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,28,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource Button.SecondaryTouch}"
                        MinWidth="160"
                        Margin="0,0,12,0"
                        Click="OnCancel" />
                <Button x:Name="OkButton"
                        Style="{StaticResource Button.PrimaryTouch}"
                        MinWidth="160"
                        Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
