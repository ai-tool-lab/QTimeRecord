<Window x:Class="QTimeRecord.App.Views.Dialogs.StaffEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:QTimeRecord.App.Views.Dialogs"
        Title="{Binding Title}"
        Width="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">

    <dialogs:StaffEditPanel x:Name="Panel" />
</Window>
