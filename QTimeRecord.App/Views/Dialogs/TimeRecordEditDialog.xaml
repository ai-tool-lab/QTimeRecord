<Window x:Class="QTimeRecord.App.Views.Dialogs.TimeRecordEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:QTimeRecord.App.Views.Dialogs"
        Title="{Binding Title}"
        Width="980"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">

    <dialogs:TimeRecordEditPanel x:Name="Panel" />
</Window>
