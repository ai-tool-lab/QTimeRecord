<UserControl x:Class="QTimeRecord.App.Views.Dialogs.StaffEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QTimeRecord.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StaffEditViewModel}"
             FontFamily="{StaticResource Font.Ui}">

    <!-- 中身を Window から切り出しているのは、目視確認用の描画に載せるため -->
    <Border Background="{StaticResource Brush.SurfaceContainerLowest}"
            BorderBrush="{StaticResource Brush.OutlineVariant}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#111827" />
        </Border.Effect>

        <StackPanel Margin="28,24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.HeadlineSm}" />

            <TextBlock Text="氏名"
                       Style="{StaticResource Text.LabelLg}"
                       Foreground="{StaticResource Brush.OnSurfaceVariant}"
                       Margin="0,20,0,0" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />

            <TextBlock Text="フリガナ"
                       Style="{StaticResource Text.LabelLg}"
                       Foreground="{StaticResource Brush.OnSurfaceVariant}"
                       Margin="0,14,0,0" />
            <!-- 名簿の並び替えはフリガナ順。漢字だけだとコード順になり探しにくい -->
            <TextBox Text="{Binding NameKana, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="社員番号"
                               Style="{StaticResource Text.LabelLg}"
                               Foreground="{StaticResource Brush.OnSurfaceVariant}" />
                    <TextBox Text="{Binding StaffNo, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="区分"
                               Style="{StaticResource Text.LabelLg}"
                               Foreground="{StaticResource Brush.OnSurfaceVariant}" />
                    <ComboBox ItemsSource="{Binding EmploymentTypeOptions}"
                              SelectedItem="{Binding EmploymentType}"
                              Margin="0,6,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource Brush.SurfaceContainerLow}"
                    CornerRadius="{StaticResource Radius.Button}"
                    Padding="16,12"
                    Margin="0,18,0,0"
                    Visibility="{Binding IssueNote, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding IssueNote}"
                           Style="{StaticResource Text.BodyLg}"
                           Foreground="{StaticResource Brush.OnSurfaceVariant}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Background="{StaticResource Brush.ErrorContainer}"
                    CornerRadius="{StaticResource Radius.Button}"
                    Padding="16,12"
                    Margin="0,14,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource Text.BodyLg}"
                           Foreground="{StaticResource Brush.OnErrorContainer}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="キャンセル"
                        Style="{StaticResource Button.SecondaryTouch}"
                        Click="OnCancel"
                        MinWidth="180"
                        Margin="0,0,12,0" />

                <Button Grid.Column="2"
                        Content="保存"
                        Style="{StaticResource Button.PrimaryTouch}"
                        Command="{Binding SaveCommand}"
                        MinWidth="200" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
