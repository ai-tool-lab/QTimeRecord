<UserControl x:Class="QTimeRecord.App.Views.Dialogs.TimeRecordEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:QTimeRecord.App.Controls"
             xmlns:vm="clr-namespace:QTimeRecord.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TimeRecordEditViewModel}"
             FontFamily="{StaticResource Font.Ui}">

    <!--
        ダイアログの中身。Window から切り出しているのは、
        目視確認用の描画（Tests/ViewRenderer）に載せるため。
        Window のままでは表示するまで描画できず、レイアウト崩れを確認できない。
    -->
    <Border Background="{StaticResource Brush.SurfaceContainerLowest}"
            BorderBrush="{StaticResource Brush.OutlineVariant}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#111827" />
        </Border.Effect>

        <Grid Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource Text.HeadlineSm}" />

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左: 対象と種別と営業日 -->
                <StackPanel Grid.Column="0" Margin="0,0,28,0">

                    <!-- その日の打刻。行から開いたときだけ選択肢が並ぶ -->
                    <TextBlock Text="対象の打刻"
                               Style="{StaticResource Text.LabelLg}"
                               Foreground="{StaticResource Brush.OnSurfaceVariant}" />
                    <ComboBox ItemsSource="{Binding Punches}"
                              SelectedItem="{Binding SelectedPunch}"
                              Margin="0,6,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="スタッフ"
                               Style="{StaticResource Text.LabelLg}"
                               Foreground="{StaticResource Brush.OnSurfaceVariant}"
                               Margin="0,16,0,0" />
                    <!-- 修正では対象を変えさせない。別人の勤怠に付け替わる -->
                    <ComboBox ItemsSource="{Binding StaffOptions}"
                              SelectedItem="{Binding SelectedStaff}"
                              IsEnabled="{Binding CanChooseStaff}"
                              Margin="0,6,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="打刻種別"
                               Style="{StaticResource Text.LabelLg}"
                               Foreground="{StaticResource Brush.OnSurfaceVariant}"
                               Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{x:Static vm:TimeRecordEditViewModel.RecordTypes}"
                              SelectedItem="{Binding SelectedRecordType}"
                              Margin="0,6,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--
                        営業日。カレンダー日付ではない（→ CLAUDE.md 必須ルール1）。
                        自動判定が取りこぼした分を直せる唯一の手段なので、必ず変更できるようにする。
                    -->
                    <TextBlock Text="営業日"
                               Style="{StaticResource Text.LabelLg}"
                               Foreground="{StaticResource Brush.OnSurfaceVariant}"
                               Margin="0,12,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="◀"
                                Style="{StaticResource Button.SecondaryTouch}"
                                Command="{Binding PreviousDayCommand}"
                                MinWidth="64"
                                Padding="0" />

                        <Border Grid.Column="1"
                                Background="{StaticResource Brush.SurfaceContainerLow}"
                                CornerRadius="{StaticResource Radius.Button}"
                                MinHeight="{StaticResource Size.TouchMin}"
                                Margin="8,0">
                            <TextBlock Text="{Binding WorkDateText}"
                                       Style="{StaticResource Text.HeadlineSm}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <Button Grid.Column="2"
                                Content="▶"
                                Style="{StaticResource Button.SecondaryTouch}"
                                Command="{Binding NextDayCommand}"
                                MinWidth="64"
                                Padding="0" />
                    </Grid>

                    <!--
                        深夜勤務では営業日と暦日がずれる。
                        実際に保存される日時を必ず見せる。見せないと、
                        翌日ぶんのつもりで当日に入れて実労働が計算できなくなる。
                    -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton Grid.Column="0"
                                      x:Name="NextDayCheck"
                                      Content="翌日"
                                      Style="{StaticResource Button.Toggle}"
                                      IsChecked="{Binding IsNextDay, Mode=OneWay}"
                                      Click="OnNextDayClick"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0" />

                        <Border Grid.Column="1"
                                Background="{StaticResource Brush.SurfaceContainerLow}"
                                CornerRadius="{StaticResource Radius.Button}"
                                MinHeight="{StaticResource Size.TouchMin}"
                                Padding="14,0">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="打刻日時: "
                                     Foreground="{StaticResource Brush.TextMuted}"
                                     FontSize="14" />
                                <Run Text="{Binding RecordedAtText, Mode=OneWay}"
                                     FontWeight="SemiBold" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <TextBlock Text="修正理由 / メモ"
                               Style="{StaticResource Text.LabelLg}"
                               Foreground="{StaticResource Brush.OnSurfaceVariant}"
                               Margin="0,12,0,0" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="{StaticResource Size.TouchMin}"
                             VerticalContentAlignment="Center"
                             Padding="12,0"
                             FontSize="16"
                             Margin="0,6,0,0" />
                </StackPanel>

                <!-- 右: 時刻。テンキーで HHMM を組み立てる -->
                <StackPanel Grid.Column="1" Width="360">
                    <TextBlock Text="時刻（24時間・HHMM）"
                               Style="{StaticResource Text.LabelLg}"
                               Foreground="{StaticResource Brush.OnSurfaceVariant}" />

                    <Border Background="{StaticResource Brush.SurfaceContainerLow}"
                            BorderBrush="{StaticResource Brush.OutlineVariant}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Button}"
                            MinHeight="{StaticResource Size.TouchMin}"
                            Margin="0,6,0,0">
                        <TextBlock Text="{Binding TimeText}"
                                   Style="{StaticResource Text.ClockDisplayMobile}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <controls:NumericKeypad x:Name="Keypad"
                                            Height="300"
                                            Margin="0,12,0,0"
                                            MaxLength="{x:Static vm:TimeRecordEditViewModel.TimeDigits}"
                                            Value="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource Brush.ErrorContainer}"
                    CornerRadius="{StaticResource Radius.Button}"
                    Padding="20,12"
                    Margin="0,16,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource Text.BodyLg}"
                           Foreground="{StaticResource Brush.OnErrorContainer}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 削除は左端に離して置く。保存の隣にあると押し間違える -->
                <Button Grid.Column="0"
                        Content="削除"
                        Style="{StaticResource Button.DangerTouch}"
                        Command="{Binding DeleteCommand}"
                        MinWidth="140" />

                <Button Grid.Column="2"
                        Content="キャンセル"
                        Style="{StaticResource Button.SecondaryTouch}"
                        Click="OnCancel"
                        MinWidth="180"
                        Margin="0,0,12,0" />

                <Button Grid.Column="3"
                        Content="保存"
                        Style="{StaticResource Button.PrimaryTouch}"
                        Command="{Binding SaveCommand}"
                        MinWidth="200" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
