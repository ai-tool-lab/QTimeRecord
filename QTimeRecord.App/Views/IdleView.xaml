<UserControl x:Class="QTimeRecord.App.Views.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QTimeRecord.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:IdleViewModel}"
             Background="{StaticResource Brush.Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー: 会社名・店舗名・接続状態・管理画面 -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.SurfaceContainerLowest}"
                BorderBrush="{StaticResource Brush.OutlineVariant}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompanyName}"
                               Style="{StaticResource Text.LabelMd}"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding StoreName}" Style="{StaticResource Text.HeadlineSm}" />
                </StackPanel>

                <!-- リーダーの状態。緑=待機中 / 赤=未接続 -->
                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        Padding="16,8"
                        CornerRadius="999">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Brush.ErrorContainer}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScannerReady}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.TertiaryFixed}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ScannerStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.LabelLg}">
                                <Setter Property="Foreground" Value="{StaticResource Brush.OnErrorContainer}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScannerReady}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource Brush.OnTertiaryFixed}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Button Grid.Column="2"
                        Content="管理画面ログイン"
                        Style="{StaticResource Button.SecondaryTouch}"
                        Command="{Binding AdminLoginCommand}"
                        MinWidth="200" />
            </Grid>
        </Border>

        <!-- 中央: 時計と読み取り案内 -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.SurfaceContainerLowest}"
                BorderBrush="{StaticResource Brush.OutlineVariant}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                Margin="0,16,0,16"
                Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Now, StringFormat={}{0:yyyy年M月d日 (dddd)}}"
                           Style="{StaticResource Text.HeadlineMd}"
                           Foreground="{StaticResource Brush.OnSurfaceVariant}"
                           HorizontalAlignment="Center" />

                <!-- 秒が動いても桁がぶれないよう等幅数字で表示する -->
                <TextBlock Text="{Binding Now, StringFormat={}{0:HH:mm:ss}}"
                           Style="{StaticResource Text.ClockDisplay}"
                           Foreground="{StaticResource Brush.Primary}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,32" />

                <TextBlock Text="QRコードをかざしてください"
                           Style="{StaticResource Text.HeadlineLg}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="社員証カードのQRコードをリーダーに向けてください。"
                           Style="{StaticResource Text.BodyLg}"
                           Foreground="{StaticResource Brush.OnSurfaceVariant}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,24" />

                <!--
                    リーダーが切れているとき。色の点だけでは、
                    かざしても反応しない理由が伝わらない。
                -->
                <Border Background="{StaticResource Brush.ErrorContainer}"
                        CornerRadius="{StaticResource Radius.Button}"
                        Padding="20,10"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ScannerNotice, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding ScannerNotice}"
                               Style="{StaticResource Text.BodyLg}"
                               Foreground="{StaticResource Brush.OnErrorContainer}" />
                </Border>

                <!--
                    読み取り窓。どこにかざせばよいかを示すための目印で、
                    四隅のかぎ括弧だけで枠を作る（DESIGN.md の Viewfinder Reticle）。
                    エラー表示中は隠す。1366x768 で両方を並べると画面からはみ出すうえ、
                    そのときに見せたいのはエラーの内容のほう。
                -->
                <Grid Width="160" Height="160" HorizontalAlignment="Center"
                      Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisible}}">
                    <Border BorderBrush="{StaticResource Brush.OutlineVariant}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Card}"
                            Background="{StaticResource Brush.SurfaceContainerLow}" />

                    <Border Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="10" BorderThickness="4,4,0,0"
                            BorderBrush="{StaticResource Brush.Primary}" />
                    <Border Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="10" BorderThickness="0,4,4,0"
                            BorderBrush="{StaticResource Brush.Primary}" />
                    <Border Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="10" BorderThickness="4,0,0,4"
                            BorderBrush="{StaticResource Brush.Primary}" />
                    <Border Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="10" BorderThickness="0,0,4,4"
                            BorderBrush="{StaticResource Brush.Primary}" />

                    <TextBlock Text="読み取り窓"
                               Style="{StaticResource Text.LabelLg}"
                               Foreground="{StaticResource Brush.TextMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 読み取り失敗の案内。一定時間で自動的に消える -->
                <Border Background="{StaticResource Brush.ErrorContainer}"
                        CornerRadius="{StaticResource Radius.Button}"
                        Padding="24,16"
                        Margin="0,0,0,0"
                        MaxWidth="720"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource Text.HeadlineSm}"
                               Foreground="{StaticResource Brush.OnErrorContainer}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 下部: 店舗からのお知らせ -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.SurfaceContainerLow}"
                BorderBrush="{StaticResource Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                Padding="24,20"
                Visibility="{Binding HasAnnouncements, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <TextBlock Text="{Binding AnnouncementTitle}"
                           Style="{StaticResource Text.HeadlineSm}"
                           Margin="0,0,0,12"
                           Visibility="{Binding AnnouncementTitle, Converter={StaticResource NullToCollapsed}}" />

                <ItemsControl ItemsSource="{Binding Announcements}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.SurfaceContainerLowest}"
                                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Button}"
                                    Margin="0,0,12,0"
                                    Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}"
                                               Style="{StaticResource Text.LabelLg}"
                                               Foreground="{StaticResource Brush.Secondary}" />
                                    <TextBlock Text="{Binding Body}"
                                               Style="{StaticResource Text.BodyMd}"
                                               Foreground="{StaticResource Brush.OnSurfaceVariant}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
