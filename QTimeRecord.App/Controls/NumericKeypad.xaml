<UserControl x:Class="QTimeRecord.App.Controls.NumericKeypad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!--
        テンキー。1キー 56px 以上・間隔 12px 以上（DESIGN.md Touch Ergonomics）。
        数字は Tag に持たせ、押されたボタンから読む。
        1つずつ Command を書くと、同じ処理が10個並ぶだけになる。
    -->
    <UniformGrid Rows="4" Columns="3">
        <Button Content="1" Tag="1" Style="{StaticResource Button.Keypad}" Click="OnDigitClick" />
        <Button Content="2" Tag="2" Style="{StaticResource Button.Keypad}" Click="OnDigitClick" />
        <Button Content="3" Tag="3" Style="{StaticResource Button.Keypad}" Click="OnDigitClick" />
        <Button Content="4" Tag="4" Style="{StaticResource Button.Keypad}" Click="OnDigitClick" />
        <Button Content="5" Tag="5" Style="{StaticResource Button.Keypad}" Click="OnDigitClick" />
        <Button Content="6" Tag="6" Style="{StaticResource Button.Keypad}" Click="OnDigitClick" />
        <Button Content="7" Tag="7" Style="{StaticResource Button.Keypad}" Click="OnDigitClick" />
        <Button Content="8" Tag="8" Style="{StaticResource Button.Keypad}" Click="OnDigitClick" />
        <Button Content="9" Tag="9" Style="{StaticResource Button.Keypad}" Click="OnDigitClick" />

        <Button Content="一文字消去"
                Style="{StaticResource Button.Keypad}"
                FontSize="16"
                Foreground="{StaticResource Brush.OnSurfaceVariant}"
                Background="{StaticResource Brush.SurfaceContainerHigh}"
                Click="OnBackspaceClick" />

        <Button Content="0" Tag="0" Style="{StaticResource Button.Keypad}" Click="OnDigitClick" />

        <!-- クリアだけ色を変える。押し間違えると入力がすべて消える -->
        <Button Content="クリア"
                Style="{StaticResource Button.Keypad}"
                FontSize="16"
                Foreground="{StaticResource Brush.OnErrorContainer}"
                Background="{StaticResource Brush.ErrorContainer}"
                BorderBrush="{StaticResource Brush.ErrorContainer}"
                Click="OnClearClick" />
    </UniformGrid>
</UserControl>
